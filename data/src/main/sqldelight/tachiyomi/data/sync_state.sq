-- Sync between devices (docs/DESKTOP_PLAN.md §3.4, S1).

-- When each synced field last changed on this device, by natural key: never a row id, which differs
-- on every device. Unused key parts are ''; field 'deleted' is a tombstone. Written by the triggers
-- SyncTriggers installs when sync is turned on, and by a merge. Empty while sync is off.
CREATE TABLE sync_state(
    entity TEXT NOT NULL,
    k1 TEXT NOT NULL,
    k2 TEXT NOT NULL,
    k3 TEXT NOT NULL,
    k4 TEXT NOT NULL,
    field TEXT NOT NULL,
    modified_at INTEGER NOT NULL,
    PRIMARY KEY(entity, k1, k2, k3, k4, field)
);

-- One row. While applying = 1 a merge is being written and the triggers stay quiet: the merge
-- writes its own times. fixed_now pins the triggers' clock in tests. triggers_version is the
-- version of the triggers installed, 0 while sync is off.
CREATE TABLE sync_control(
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    applying INTEGER NOT NULL DEFAULT 0,
    fixed_now INTEGER,
    triggers_version INTEGER NOT NULL DEFAULT 0
);

INSERT OR IGNORE INTO sync_control(id) VALUES (0);

-- State

allStates:
SELECT *
FROM sync_state;

putState:
INSERT OR REPLACE INTO sync_state(entity, k1, k2, k3, k4, field, modified_at)
VALUES (:entity, :k1, :k2, :k3, :k4, :field, :modifiedAt);

deleteStatesOf:
DELETE FROM sync_state
WHERE entity = :entity AND k1 = :k1 AND k2 = :k2 AND k3 = :k3 AND k4 = :k4;

deleteAllStates:
DELETE FROM sync_state;

control:
SELECT *
FROM sync_control
WHERE id = 0;

setApplying:
UPDATE sync_control
SET applying = :applying
WHERE id = 0;

setFixedNow:
UPDATE sync_control
SET fixed_now = :now
WHERE id = 0;

setTriggersVersion:
UPDATE sync_control
SET triggers_version = :version
WHERE id = 0;

-- What this device has. Entries count when they are in the library or anything was done with them.

syncMangas:
SELECT M._id, M.source, M.url, M.favorite, M.date_added, M.viewer, M.chapter_flags, M.notes, M.title,
    M.author, M.artist, M.description, M.genre, M.status, M.thumbnail_url, M.update_strategy, M.initialized
FROM mangas M
WHERE M.favorite = 1
    OR EXISTS (
        SELECT 1 FROM chapters C
        WHERE C.manga_id = M._id AND (C.read = 1 OR C.bookmark = 1 OR C.last_page_read > 0)
    )
    OR EXISTS (SELECT 1 FROM chapters C JOIN history H ON H.chapter_id = C._id WHERE C.manga_id = M._id)
    OR EXISTS (SELECT 1 FROM manga_sync T WHERE T.manga_id = M._id)
    OR EXISTS (SELECT 1 FROM mangas_categories MC WHERE MC.manga_id = M._id)
    OR EXISTS (SELECT 1 FROM comic_metadata D WHERE D.manga_id = M._id AND D.confirmed = 1)
    OR EXISTS (SELECT 1 FROM reading_collection_items I WHERE I.manga_id = M._id)
    OR EXISTS (SELECT 1 FROM start_feedback F WHERE F.subject_kind = 0 AND F.subject_key = CAST(M._id AS TEXT))
    OR EXISTS (
        SELECT 1 FROM sync_state S
        WHERE S.entity = 'manga' AND S.k1 = CAST(M.source AS TEXT) AND S.k2 = M.url
    );

syncChapters:
SELECT M.source, M.url AS manga_url, C.url, C.read, C.bookmark, C.last_page_read, C.name, C.scanlator,
    C.chapter_number, C.source_order, C.date_fetch, C.date_upload
FROM chapters C
JOIN mangas M ON M._id = C.manga_id
WHERE C.read = 1 OR C.bookmark = 1 OR C.last_page_read > 0
    OR EXISTS (
        SELECT 1 FROM sync_state S
        WHERE S.entity = 'chapter' AND S.k1 = CAST(M.source AS TEXT) AND S.k2 = M.url AND S.k3 = C.url
    );

syncHistory:
SELECT M.source, M.url AS manga_url, C.url AS chapter_url, H.last_read, H.time_read
FROM history H
JOIN chapters C ON C._id = H.chapter_id
JOIN mangas M ON M._id = C.manga_id;

syncCategories:
SELECT name, sort, flags
FROM categories
WHERE _id > 0;

syncMangaCategories:
SELECT M.source, M.url, CA.name
FROM mangas_categories MC
JOIN mangas M ON M._id = MC.manga_id
JOIN categories CA ON CA._id = MC.category_id
WHERE CA._id > 0;

syncTracks:
SELECT M.source, M.url AS manga_url, T.sync_id, T.remote_id, T.library_id, T.title, T.last_chapter_read,
    T.total_chapters, T.status, T.score, T.remote_url, T.start_date, T.finish_date, T.private
FROM manga_sync T
JOIN mangas M ON M._id = T.manga_id;

syncExtensionStores:
SELECT *
FROM extension_store;

-- A session the reader is still writing is not synced: it goes once it is closed.
syncSessions:
SELECT *
FROM reading_sessions
WHERE state != 0;

syncSessionDays:
SELECT S.session_uuid, D.local_date, D.active_ms, D.pages_new, D.pages_visited
FROM reading_day_segments D
JOIN reading_sessions S ON S._id = D.session_id
WHERE S.state != 0
ORDER BY S.session_uuid, D.local_date;

syncProgress:
SELECT M.source, M.url AS manga_url, C.url AS chapter_url, P.pages_seen, P.max_page_reached,
    P.total_pages, P.completed_at, P.completed_on, P.completion_origin
FROM chapter_reading_progress P
JOIN chapters C ON C._id = P.chapter_id
JOIN mangas M ON M._id = C.manga_id;

syncStatsMeta:
SELECT *
FROM reading_stats_meta;

syncGoals:
SELECT *
FROM reading_goals;

syncCollections:
SELECT *
FROM reading_collections;

syncCollectionItems:
SELECT C.uuid, I.position, I.source_id, I.manga_url, I.chapter_url, I.label
FROM reading_collection_items I
JOIN reading_collections C ON C._id = I.collection_id
ORDER BY C.uuid, I.position, I._id;

syncPlans:
SELECT P.uuid, C.uuid AS collection_uuid, P.pace_per_week, P.started_at, P.started_on, P.paused
FROM reading_plans P
JOIN reading_collections C ON C._id = P.collection_id;

syncMetadata:
SELECT M.source, M.url AS manga_url, coalesce(C.url, '') AS chapter_url, D.field, D.position, D.value,
    D.origin
FROM comic_metadata D
JOIN mangas M ON M._id = D.manga_id
LEFT JOIN chapters C ON C._id = D.chapter_id
WHERE D.confirmed = 1 AND (D.chapter_id IS NULL OR C._id IS NOT NULL)
ORDER BY M.source, M.url, chapter_url, D.field, D.position, D._id;

syncFollows:
SELECT *
FROM release_follows;

syncNotified:
SELECT *
FROM release_notified;

syncFeedback:
SELECT F.subject_kind, F.subject_key, F.verdict, F.until_at, F.created_at, M.source, M.url
FROM start_feedback F
LEFT JOIN mangas M ON F.subject_kind = 0 AND M._id = CAST(F.subject_key AS INTEGER);

-- Writing a merge, by natural key.

mangaIdOf:
SELECT _id
FROM mangas
WHERE source = :source AND url = :url
ORDER BY _id
LIMIT 1;

insertManga:
INSERT INTO mangas(source, url, artist, author, description, genre, title, status, thumbnail_url, favorite,
    last_update, next_update, initialized, viewer, chapter_flags, cover_last_modified, date_added,
    update_strategy, calculate_interval, notes)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favorite,
    0, 0, :initialized, :viewer, :chapterFlags, 0, :dateAdded, :updateStrategy, 0, :notes)
RETURNING _id;

setMangaFavorite:
UPDATE mangas
SET favorite = :favorite
WHERE _id = :id;

setMangaDateAdded:
UPDATE mangas
SET date_added = :dateAdded
WHERE _id = :id;

setMangaSettings:
UPDATE mangas
SET viewer = :viewer, chapter_flags = :chapterFlags
WHERE _id = :id;

setMangaNotes:
UPDATE mangas
SET notes = :notes
WHERE _id = :id;

chapterIdsOf:
SELECT _id, url
FROM chapters
WHERE manga_id = :mangaId
ORDER BY _id DESC;

insertChapter:
INSERT INTO chapters(manga_id, url, name, scanlator, read, bookmark, last_page_read, chapter_number,
    source_order, date_fetch, date_upload)
VALUES (:mangaId, :url, :name, :scanlator, :read, :bookmark, :lastPageRead, :chapterNumber,
    :sourceOrder, :dateFetch, :dateUpload)
RETURNING _id;

-- In batches: a first sync can mark thousands of chapters, and one statement per chapter is slow.

setChaptersRead:
UPDATE chapters
SET read = :read
WHERE _id IN :ids;

setChaptersBookmark:
UPDATE chapters
SET bookmark = :bookmark
WHERE _id IN :ids;

setChaptersPage:
UPDATE chapters
SET last_page_read = :page
WHERE _id IN :ids;

putHistory:
INSERT INTO history(chapter_id, last_read, time_read)
VALUES (:chapterId, :lastRead, :timeRead)
ON CONFLICT(chapter_id) DO UPDATE SET last_read = :lastRead, time_read = :timeRead;

deleteHistory:
DELETE FROM history
WHERE chapter_id = :chapterId;

categoryIdOf:
SELECT _id
FROM categories
WHERE name = :name AND _id > 0
ORDER BY _id
LIMIT 1;

insertCategory:
INSERT INTO categories(name, sort, flags)
VALUES (:name, :sort, :flags);

setCategory:
UPDATE categories
SET sort = :sort, flags = :flags
WHERE _id = :id;

deleteCategory:
DELETE FROM categories
WHERE _id = :id;

hasMangaCategory:
SELECT count(*)
FROM mangas_categories
WHERE manga_id = :mangaId AND category_id = :categoryId;

insertMangaCategory:
INSERT INTO mangas_categories(manga_id, category_id)
VALUES (:mangaId, :categoryId);

deleteMangaCategory:
DELETE FROM mangas_categories
WHERE manga_id = :mangaId AND category_id = :categoryId;

putTrack:
INSERT INTO manga_sync(manga_id, sync_id, remote_id, library_id, title, last_chapter_read, total_chapters,
    status, score, remote_url, start_date, finish_date, private)
VALUES (:mangaId, :syncId, :remoteId, :libraryId, :title, :lastChapterRead, :totalChapters, :status, :score,
    :remoteUrl, :startDate, :finishDate, :private);

deleteTrack:
DELETE FROM manga_sync
WHERE manga_id = :mangaId AND sync_id = :syncId;

putExtensionStore:
INSERT OR REPLACE INTO extension_store(index_url, name, badge_label, signing_key, contact_website,
    contact_discord, is_legacy, extension_list_url)
VALUES (:indexUrl, :name, :badgeLabel, :signingKey, :contactWebsite, :contactDiscord, :isLegacy,
    :extensionListUrl);

deleteExtensionStore:
DELETE FROM extension_store
WHERE index_url = :indexUrl;

sessionOf:
SELECT _id, state, chapter_id
FROM reading_sessions
WHERE session_uuid = :uuid;

-- A new session is never first: which session completed a chapter first is worked out after the
-- merge, over the sessions of both devices.
putSession:
INSERT INTO reading_sessions(
    session_uuid, manga_id, chapter_id, source_id, manga_url, chapter_url, manga_title, chapter_name,
    chapter_number, started_at, ended_at, active_ms, first_page, last_page, pages_visited, pages_new,
    pages_reread, page_advances, total_pages, pages_bits, completed_at, completed_on, first_completion,
    origin, state, zone_id
)
VALUES (
    :uuid, :mangaId, :chapterId, :sourceId, :mangaUrl, :chapterUrl, :mangaTitle, :chapterName,
    :chapterNumber, :startedAt, :endedAt, :activeMs, :firstPage, :lastPage, :pagesVisited, :pagesNew,
    :pagesReread, :pageAdvances, :totalPages, :pagesBits, :completedAt, :completedOn, 0,
    :origin, :state, :zoneId
)
ON CONFLICT(session_uuid) DO UPDATE SET
    manga_id = :mangaId,
    chapter_id = :chapterId,
    source_id = :sourceId,
    manga_url = :mangaUrl,
    chapter_url = :chapterUrl,
    manga_title = :mangaTitle,
    chapter_name = :chapterName,
    chapter_number = :chapterNumber,
    started_at = :startedAt,
    ended_at = :endedAt,
    active_ms = :activeMs,
    first_page = :firstPage,
    last_page = :lastPage,
    pages_visited = :pagesVisited,
    pages_new = :pagesNew,
    pages_reread = :pagesReread,
    page_advances = :pageAdvances,
    total_pages = :totalPages,
    pages_bits = :pagesBits,
    completed_at = :completedAt,
    completed_on = :completedOn,
    origin = :origin,
    state = :state,
    zone_id = :zoneId;

deleteSessionDays:
DELETE FROM reading_day_segments
WHERE session_id = :sessionId;

insertSessionDay:
INSERT INTO reading_day_segments(session_id, local_date, active_ms, pages_new, pages_visited)
VALUES (:sessionId, :localDate, :activeMs, :pagesNew, :pagesVisited);

deleteSession:
DELETE FROM reading_sessions
WHERE session_uuid = :uuid;

clearFirstCompletion:
UPDATE reading_sessions
SET first_completion = 0
WHERE chapter_id = :chapterId AND first_completion = 1;

putStatsMeta:
INSERT OR REPLACE INTO reading_stats_meta(key, value)
VALUES (:key, :value);

putGoal:
INSERT OR REPLACE INTO reading_goals(metric, period, target, is_primary, updated_at)
VALUES (:metric, :period, :target, :isPrimary, :updatedAt);

deleteGoal:
DELETE FROM reading_goals
WHERE metric = :metric AND period = :period;

collectionIdOf:
SELECT _id
FROM reading_collections
WHERE uuid = :uuid;

insertCollection:
INSERT INTO reading_collections(uuid, kind, name, created_at, standalone)
VALUES (:uuid, :kind, :name, :createdAt, :standalone);

setCollection:
UPDATE reading_collections
SET kind = :kind, name = :name, created_at = :createdAt, standalone = :standalone
WHERE _id = :id;

deleteCollectionItems:
DELETE FROM reading_collection_items
WHERE collection_id = :collectionId;

insertCollectionItem:
INSERT INTO reading_collection_items(collection_id, position, manga_id, chapter_id, source_id, manga_url,
    chapter_url, label)
VALUES (:collectionId, :position, :mangaId, :chapterId, :sourceId, :mangaUrl, :chapterUrl, :label);

deleteCollection:
DELETE FROM reading_collections
WHERE uuid = :uuid;

putPlan:
INSERT INTO reading_plans(uuid, collection_id, pace_per_week, started_at, started_on, paused)
VALUES (:uuid, :collectionId, :pacePerWeek, :startedAt, :startedOn, :paused)
ON CONFLICT(uuid) DO UPDATE SET
    collection_id = :collectionId,
    pace_per_week = :pacePerWeek,
    started_at = :startedAt,
    started_on = :startedOn,
    paused = :paused;

deletePlan:
DELETE FROM reading_plans
WHERE uuid = :uuid;

deleteConfirmedField:
DELETE FROM comic_metadata
WHERE manga_id = :mangaId AND chapter_id IS :chapterId AND field = :field AND confirmed = 1;

insertConfirmedValue:
INSERT INTO comic_metadata(manga_id, chapter_id, field, position, value, origin, confirmed)
VALUES (:mangaId, :chapterId, :field, :position, :value, :origin, 1);

putFollow:
INSERT OR REPLACE INTO release_follows(kind, follow_key, label, series_name, series_year, number, created_at)
VALUES (:kind, :followKey, :label, :seriesName, :seriesYear, :number, :createdAt);

deleteFollow:
DELETE FROM release_follows
WHERE kind = :kind AND follow_key = :followKey;

putNotified:
INSERT OR REPLACE INTO release_notified(release_key, what, series_key, series_name, series_year, number,
    store_date, notified_at)
VALUES (:releaseKey, :what, :seriesKey, :seriesName, :seriesYear, :number, :storeDate, :notifiedAt);

putFeedback:
INSERT OR REPLACE INTO start_feedback(subject_kind, subject_key, verdict, until_at, created_at)
VALUES (:subjectKind, :subjectKey, :verdict, :untilAt, :createdAt);

deleteFeedback:
DELETE FROM start_feedback
WHERE subject_kind = :subjectKind AND subject_key = :subjectKey;
