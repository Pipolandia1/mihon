import kotlin.Boolean;

-- When reading began to be recorded. Periods before it have no measured time or pages.
CREATE TABLE reading_stats_meta(
    key TEXT NOT NULL PRIMARY KEY,
    value INTEGER NOT NULL
);

INSERT OR IGNORE INTO reading_stats_meta(key, value)
VALUES ('recording_started_at', CAST(strftime('%s', 'now') AS INTEGER) * 1000);

-- One reading session of one chapter. The reader rewrites it with absolute figures as it goes,
-- so writing it again never counts anything twice. It outlives its entry and chapter: their ids
-- turn NULL and the names it was read under remain.
CREATE TABLE reading_sessions(
    _id INTEGER NOT NULL PRIMARY KEY,
    session_uuid TEXT NOT NULL UNIQUE,
    manga_id INTEGER REFERENCES mangas(_id) ON DELETE SET NULL,
    chapter_id INTEGER REFERENCES chapters(_id) ON DELETE SET NULL,
    source_id INTEGER NOT NULL,
    manga_url TEXT NOT NULL,
    chapter_url TEXT NOT NULL,
    manga_title TEXT NOT NULL,
    chapter_name TEXT NOT NULL,
    chapter_number REAL NOT NULL,
    started_at INTEGER NOT NULL,
    ended_at INTEGER NOT NULL,
    active_ms INTEGER NOT NULL,
    first_page INTEGER NOT NULL,
    last_page INTEGER NOT NULL,
    pages_visited INTEGER NOT NULL,
    pages_new INTEGER NOT NULL,
    pages_reread INTEGER NOT NULL,
    page_advances INTEGER NOT NULL,
    total_pages INTEGER,
    pages_bits BLOB NOT NULL,
    completed_at INTEGER,
    completed_on TEXT,
    first_completion INTEGER AS Boolean NOT NULL,
    origin INTEGER NOT NULL,
    state INTEGER NOT NULL,
    zone_id TEXT NOT NULL
);

CREATE INDEX reading_sessions_ended_at_index ON reading_sessions(ended_at);
CREATE INDEX reading_sessions_chapter_id_index ON reading_sessions(chapter_id);
CREATE INDEX reading_sessions_manga_id_index ON reading_sessions(manga_id);
CREATE INDEX reading_sessions_completed_on_index ON reading_sessions(completed_on) WHERE first_completion = 1;

-- A session's share of each calendar day, in the time zone in force when the time was spent.
CREATE TABLE reading_day_segments(
    session_id INTEGER NOT NULL REFERENCES reading_sessions(_id) ON DELETE CASCADE,
    local_date TEXT NOT NULL,
    active_ms INTEGER NOT NULL,
    pages_new INTEGER NOT NULL,
    pages_visited INTEGER NOT NULL,
    PRIMARY KEY(session_id, local_date)
);

CREATE INDEX reading_day_segments_local_date_index ON reading_day_segments(local_date);

-- Everything known about a chapter across its sessions: which pages were ever reached, and when
-- and how it was first completed.
CREATE TABLE chapter_reading_progress(
    chapter_id INTEGER NOT NULL PRIMARY KEY REFERENCES chapters(_id) ON DELETE CASCADE,
    pages_seen BLOB,
    max_page_reached INTEGER NOT NULL,
    total_pages INTEGER,
    completed_at INTEGER,
    completed_on TEXT,
    completion_origin INTEGER
);

CREATE INDEX chapter_reading_progress_completed_on_index ON chapter_reading_progress(completed_on);

getRecordingStartedAt:
SELECT value
FROM reading_stats_meta
WHERE key = 'recording_started_at';

setRecordingStartedAt:
INSERT INTO reading_stats_meta(key, value)
VALUES ('recording_started_at', :startedAt)
ON CONFLICT(key) DO UPDATE SET value = :startedAt;

moveRecordingStartBack:
UPDATE reading_stats_meta
SET value = :startedAt
WHERE key = 'recording_started_at' AND value > :startedAt;

chapterExists:
SELECT count(*)
FROM chapters
WHERE _id = :chapterId;

mangaExists:
SELECT count(*)
FROM mangas
WHERE _id = :mangaId;

upsertSession:
INSERT INTO reading_sessions(
    session_uuid, manga_id, chapter_id, source_id, manga_url, chapter_url, manga_title, chapter_name,
    chapter_number, started_at, ended_at, active_ms, first_page, last_page, pages_visited, pages_new,
    pages_reread, page_advances, total_pages, pages_bits, completed_at, completed_on, first_completion,
    origin, state, zone_id
)
VALUES (
    :uuid, :mangaId, :chapterId, :sourceId, :mangaUrl, :chapterUrl, :mangaTitle, :chapterName,
    :chapterNumber, :startedAt, :endedAt, :activeMs, :firstPage, :lastPage, :pagesVisited, :pagesNew,
    :pagesReread, :pageAdvances, :totalPages, :pagesBits, :completedAt, :completedOn, :firstCompletion,
    :origin, :state, :zoneId
)
ON CONFLICT(session_uuid) DO UPDATE SET
    manga_id = :mangaId,
    chapter_id = :chapterId,
    ended_at = :endedAt,
    active_ms = :activeMs,
    first_page = :firstPage,
    last_page = :lastPage,
    pages_visited = :pagesVisited,
    pages_new = :pagesNew,
    pages_reread = :pagesReread,
    page_advances = :pageAdvances,
    total_pages = :totalPages,
    pages_bits = :pagesBits,
    completed_at = :completedAt,
    completed_on = :completedOn,
    first_completion = :firstCompletion,
    state = :state;

getSessionId:
SELECT _id
FROM reading_sessions
WHERE session_uuid = :uuid;

upsertDay:
INSERT INTO reading_day_segments(session_id, local_date, active_ms, pages_new, pages_visited)
VALUES (:sessionId, :localDate, :activeMs, :pagesNew, :pagesVisited)
ON CONFLICT(session_id, local_date) DO UPDATE SET
    active_ms = :activeMs,
    pages_new = :pagesNew,
    pages_visited = :pagesVisited;

-- Pages reached and totals only grow; a first completion, once set, stays.
upsertProgress:
INSERT INTO chapter_reading_progress(
    chapter_id, pages_seen, max_page_reached, total_pages, completed_at, completed_on, completion_origin
)
VALUES (:chapterId, :pagesSeen, :maxPageReached, :totalPages, :completedAt, :completedOn, :completionOrigin)
ON CONFLICT(chapter_id) DO UPDATE SET
    pages_seen = :pagesSeen,
    max_page_reached = max(max_page_reached, :maxPageReached),
    total_pages = coalesce(:totalPages, total_pages),
    completed_at = CASE WHEN completion_origin IS NULL THEN :completedAt ELSE completed_at END,
    completed_on = CASE WHEN completion_origin IS NULL THEN :completedOn ELSE completed_on END,
    completion_origin = coalesce(completion_origin, :completionOrigin);

replaceProgress:
INSERT OR REPLACE INTO chapter_reading_progress(
    chapter_id, pages_seen, max_page_reached, total_pages, completed_at, completed_on, completion_origin
)
VALUES (:chapterId, :pagesSeen, :maxPageReached, :totalPages, :completedAt, :completedOn, :completionOrigin);

getProgress:
SELECT *
FROM chapter_reading_progress
WHERE chapter_id = :chapterId;

getLatestReaderSession:
SELECT *
FROM reading_sessions
WHERE origin = 0
ORDER BY ended_at DESC
LIMIT 1;

getSessionById:
SELECT *
FROM reading_sessions
WHERE _id = :sessionId;

getDaysOfSession:
SELECT *
FROM reading_day_segments
WHERE session_id = :sessionId
ORDER BY local_date;

closeStaleSessions:
UPDATE reading_sessions
SET state = 2
WHERE state = 0 AND ended_at < :endedBefore;

markCompletedManually:
INSERT INTO chapter_reading_progress(
    chapter_id, pages_seen, max_page_reached, total_pages, completed_at, completed_on, completion_origin
)
VALUES (:chapterId, NULL, -1, NULL, :completedAt, :completedOn, 1)
ON CONFLICT(chapter_id) DO UPDATE SET
    completed_at = :completedAt,
    completed_on = :completedOn,
    completion_origin = 1
WHERE completion_origin IS NULL;

clearManualCompletion:
UPDATE chapter_reading_progress
SET completed_at = NULL, completed_on = NULL, completion_origin = NULL
WHERE chapter_id IN :chapterIds AND completion_origin = 1;

deleteSession:
DELETE FROM reading_sessions
WHERE _id = :sessionId;

getFirstCompletingSession:
SELECT *
FROM reading_sessions
WHERE chapter_id = :chapterId AND completed_at IS NOT NULL AND origin = 0
ORDER BY completed_at
LIMIT 1;

setFirstCompletion:
UPDATE reading_sessions
SET first_completion = 1
WHERE _id = :sessionId;

setReaderCompletion:
UPDATE chapter_reading_progress
SET completed_at = :completedAt, completed_on = :completedOn, completion_origin = 0
WHERE chapter_id = :chapterId AND completion_origin = 0;

clearReaderCompletion:
UPDATE chapter_reading_progress
SET completed_at = NULL, completed_on = NULL, completion_origin = NULL
WHERE chapter_id = :chapterId AND completion_origin = 0;

deleteAllSessions:
DELETE FROM reading_sessions;

deleteAllProgress:
DELETE FROM chapter_reading_progress;

moveSessionsOfChapter:
UPDATE reading_sessions
SET manga_id = :toMangaId, chapter_id = :toChapterId,
    source_id = :sourceId, manga_url = :mangaUrl, chapter_url = :chapterUrl
WHERE chapter_id = :fromChapterId;

moveProgressOfChapter:
UPDATE OR IGNORE chapter_reading_progress
SET chapter_id = :toChapterId
WHERE chapter_id = :fromChapterId;

daySums:
SELECT local_date, sum(active_ms) AS active_ms, sum(pages_new) AS pages_new,
       sum(pages_visited) AS pages_visited, count(*) AS sessions
FROM reading_day_segments
WHERE local_date BETWEEN :from AND :to
GROUP BY local_date;

allDaySums:
SELECT local_date, sum(active_ms) AS active_ms, sum(pages_new) AS pages_new,
       sum(pages_visited) AS pages_visited, count(*) AS sessions
FROM reading_day_segments
GROUP BY local_date;

longestSession:
SELECT _id, manga_title, chapter_name, chapter_number, active_ms, started_at
FROM reading_sessions
WHERE origin = 0
ORDER BY active_ms DESC
LIMIT 1;

readerCompletionsByDay:
SELECT completed_on, count(*) AS completed
FROM reading_sessions
WHERE first_completion = 1 AND completed_on BETWEEN :from AND :to
GROUP BY completed_on;

otherCompletionsByDay:
SELECT completed_on, completion_origin, count(*) AS completed
FROM chapter_reading_progress
WHERE completion_origin IN (1, 2) AND completed_on BETWEEN :from AND :to
GROUP BY completed_on, completion_origin;

sessionsOnDay:
SELECT
    S._id, S.manga_id, S.chapter_id, S.manga_title, S.chapter_name, S.chapter_number,
    S.started_at, S.ended_at, S.total_pages, S.completed_on, S.first_completion, S.state,
    D.active_ms AS day_active_ms, D.pages_new AS day_pages_new, D.pages_visited AS day_pages_visited,
    M.thumbnail_url, M.source, M.favorite, M.cover_last_modified
FROM reading_day_segments D
JOIN reading_sessions S ON S._id = D.session_id
LEFT JOIN mangas M ON M._id = S.manga_id
WHERE D.local_date = :date
ORDER BY S.started_at DESC;

completionsOnDay:
SELECT
    P.chapter_id, P.completed_at, P.completion_origin,
    C.name AS chapter_name, C.chapter_number,
    M._id AS manga_id, M.title, M.thumbnail_url, M.source, M.favorite, M.cover_last_modified
FROM chapter_reading_progress P
JOIN chapters C ON C._id = P.chapter_id
JOIN mangas M ON M._id = C.manga_id
WHERE P.completed_on = :date AND P.completion_origin IN (1, 2)
ORDER BY P.completed_at DESC;

legacyHistoryBetween:
SELECT
    H.chapter_id, H.last_read,
    C.name AS chapter_name, C.chapter_number,
    M._id AS manga_id, M.title, M.thumbnail_url, M.source, M.favorite, M.cover_last_modified
FROM history H
JOIN chapters C ON C._id = H.chapter_id
JOIN mangas M ON M._id = C.manga_id
WHERE H.last_read >= :from AND H.last_read < :to
ORDER BY H.last_read DESC;

allSessions:
SELECT *
FROM reading_sessions;

allDays:
SELECT *
FROM reading_day_segments;

allProgress:
SELECT P.*, C.url AS chapter_url, C.name AS chapter_name, C.chapter_number,
       M.url AS manga_url, M.source, M.title
FROM chapter_reading_progress P
JOIN chapters C ON C._id = P.chapter_id
JOIN mangas M ON M._id = C.manga_id;

-- The earliest day with anything recorded or carried over, for "all time".
firstActivityDate:
SELECT min(d) AS first_date FROM (
    SELECT min(local_date) AS d FROM reading_day_segments
    UNION ALL
    SELECT min(completed_on) FROM chapter_reading_progress WHERE completion_origin IN (1, 2)
    UNION ALL
    SELECT min(completed_on) FROM reading_sessions WHERE first_completion = 1
);

-- Reader sessions with any reading on the days from :from to :to.
sessionsInPeriod:
SELECT _id, started_at, ended_at, active_ms, pages_new, zone_id, manga_id, chapter_id,
       manga_title, chapter_name, chapter_number
FROM reading_sessions
WHERE origin = 0 AND _id IN (
    SELECT session_id FROM reading_day_segments WHERE local_date BETWEEN :from AND :to
)
ORDER BY started_at;

-- Active time per chapter on the days from :from to :to; a deleted chapter keeps its entry's title.
readingByChapter:
SELECT S.manga_id, S.chapter_id, S.manga_title, sum(D.active_ms) AS active_ms
FROM reading_day_segments D
JOIN reading_sessions S ON S._id = D.session_id
WHERE D.local_date BETWEEN :from AND :to
GROUP BY S.manga_id, S.chapter_id, S.manga_title;

-- Chapters first completed in the reader, or marked read by hand, on the days from :from to :to.
-- Issues first finished in the reader from :from to :to, each with the active time of every session
-- of it up to the one that finished it: how long an issue takes (Início, amendment H2).
readerCompletionTimes:
SELECT done.chapter_id, done.manga_id, sum(S.active_ms) AS active_ms
FROM reading_sessions done
JOIN reading_sessions S ON S.chapter_id = done.chapter_id AND S.started_at <= done.ended_at
WHERE done.first_completion = 1 AND done.origin = 0 AND done.chapter_id IS NOT NULL
    AND done.completed_on BETWEEN :from AND :to
GROUP BY done._id;

completedChaptersInPeriod:
SELECT S.chapter_id, C.manga_id
FROM reading_sessions S
JOIN chapters C ON C._id = S.chapter_id
WHERE S.first_completion = 1 AND S.completed_on BETWEEN :from AND :to
UNION
SELECT P.chapter_id, C.manga_id
FROM chapter_reading_progress P
JOIN chapters C ON C._id = P.chapter_id
WHERE P.completion_origin = 1 AND P.completed_on BETWEEN :from AND :to;
